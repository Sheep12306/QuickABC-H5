# ===== 后端地址 =====
# 方式一（本地开发/直接连后端）：填写完整地址，末尾不要带 /
VITE_API_BASE=http://115.29.149.87:3001/api
VITE_SERVER_BASE=http://115.29.149.87:3001

# 方式二（推荐正式部署）：前后端同域，由 Nginx/Vite 反向代理
# 同时设置 VITE_PROXY_TARGET（仅 vite dev 使用）指向真实后端
# VITE_API_BASE=/api
# VITE_SERVER_BASE=
# VITE_PROXY_TARGET=https://api.your-domain.com

# 是否在启动时自动用设备 ID 登录 H5 账号
VITE_AUTO_LOGIN=true
